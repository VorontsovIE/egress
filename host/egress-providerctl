#!/usr/bin/env python3
"""Host-only provider source manager. All commands have a fixed operation."""
from __future__ import annotations

import argparse
import getpass
import json
import os
import pwd
import re
import stat
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(os.environ.get("VIBELAB_EGRESS_ROOT", "/home/vibelab/openscience/egress"))
SECRETS = Path(os.environ.get("VIBELAB_EGRESS_SECRETS", "/etc/vibelab-egress/secrets"))
API = os.environ.get("VIBELAB_EGRESS_API", "http://127.0.0.1:9091")
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def fail(message: str) -> None:
    raise SystemExit(f"egress-providerctl: {message}")


def check_id(value: str) -> str:
    if not ID_RE.fullmatch(value):
        fail("invalid provider ID")
    return value


def source_dir() -> Path:
    return SECRETS / "providers"


def private_write(path: Path, data: bytes) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".provider-")
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(tmp, 0o600)
        if os.geteuid() == 0:
            try:
                account = pwd.getpwnam("vibelab-egressd")
                os.chown(tmp, account.pw_uid, account.pw_gid)
            except KeyError:
                # Offline install tests have no service account.
                os.chown(tmp, 1000, 1000)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def read_source_file(value: str) -> bytes:
    input_path = Path(value)
    info = input_path.stat()
    if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
        fail("source file must be regular with mode 0600")
    if info.st_size > 4 * 1024 * 1024:
        fail("source file too large")
    data = input_path.read_bytes()
    if not data:
        fail("source file is empty")
    return data


def api(method: str, path: str) -> dict:
    token = (SECRETS / "clients" / "host-main.token").read_text().strip()
    request = urllib.request.Request(API + path, method=method,
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
        data=b"{}" if method == "POST" else None)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return json.load(response)
    except (urllib.error.URLError, ValueError):
        fail("backend request failed; source remains stored for retry")


def add(args: argparse.Namespace) -> None:
    provider_id = check_id(args.id)
    path = source_dir() / f"{provider_id}.json"
    if path.exists() or (ROOT / "providers" / f"{provider_id}.yaml").exists():
        fail("provider ID already exists")
    if args.subscription_url:
        url = getpass.getpass("Subscription URL: ").strip()
        if not url:
            fail("empty subscription URL")
        if "://" not in url:
            url = "https://" + url
        from urllib.parse import urlsplit
        parsed = urlsplit(url)
        if parsed.scheme not in ("http", "https") or not parsed.hostname:
            fail("invalid subscription URL")
        source = {"type": "url", "url": url}
    else:
        data = read_source_file(args.source_file)
        private_write(source_dir() / f"{provider_id}.source", data)
        source = {"type": "file"}
    private_write(path, json.dumps(source).encode())
    result = api("POST", f"/v1/providers/{provider_id}/update")
    print(json.dumps({"id": provider_id, "type": source["type"],
                      "node_count": result.get("nodes_after", 0)}))


def list_sources(_: argparse.Namespace) -> None:
    data = api("GET", "/v1/providers")
    for provider in data.get("providers", []):
        print(json.dumps({key: provider.get(key) for key in
              ("id", "type", "node_count", "last_success", "last_error")}))


def update(args: argparse.Namespace) -> None:
    provider_id = check_id(args.id)
    if args.source_file:
        path = source_dir() / f"{provider_id}.json"
        try:
            metadata = json.loads(path.read_text())
        except (OSError, ValueError):
            fail("provider ID not found")
        if metadata.get("type") != "file":
            fail("source-file replacement requires a file provider")
        private_write(source_dir() / f"{provider_id}.source",
                      read_source_file(args.source_file))
    result = api("POST", f"/v1/providers/{provider_id}/update")
    print(json.dumps({"id": provider_id, "node_count": result.get("nodes_after", 0),
                      "updated": result.get("updated", False)}))


def remove(args: argparse.Namespace) -> None:
    provider_id = check_id(args.id)
    found = False
    for path in (source_dir() / f"{provider_id}.json",
                 source_dir() / f"{provider_id}.source",
                 ROOT / "providers" / f"{provider_id}.yaml",
                 ROOT / "providers" / f"{provider_id}.yaml.lkg",
                 ROOT / "egressd" / "provider-status" / f"{provider_id}.json"):
        if path.exists():
            path.unlink()
            found = True
    if not found:
        fail("provider ID not found")
    api("POST", "/v1/reconcile")
    print(json.dumps({"id": provider_id, "removed": True}))


def main() -> None:
    parser = argparse.ArgumentParser(prog="egress-providerctl")
    commands = parser.add_subparsers(dest="command", required=True)
    add_cmd = commands.add_parser("add")
    add_cmd.add_argument("--id", required=True)
    source = add_cmd.add_mutually_exclusive_group(required=True)
    source.add_argument("--subscription-url", action="store_true")
    source.add_argument("--source-file")
    for name in ("update", "remove"):
        command = commands.add_parser(name)
        command.add_argument("--id", required=True)
        if name == "update":
            command.add_argument("--source-file")
    commands.add_parser("list")
    args = parser.parse_args()
    if os.geteuid() != 0:
        fail("host root required")
    {"add": add, "list": list_sources, "update": update, "remove": remove}[args.command](args)


if __name__ == "__main__":
    main()
