#!/usr/bin/env python3
"""egress-hostctl -- narrow host-side control CLI for egress (phase A1).

Security invariants (TECH_SPEC.md sections 33-38):
  * Python 3 standard library only.
  * No arbitrary shell / command execution. The only external commands ever
    run are a fixed, hardcoded allowlist: `docker` (specific subcommands).
    Every subprocess.run uses a fixed argv list; no shell=True, no os.system.
  * No secrets in any output.
  * Fixed operations only. Unknown subcommand -> stderr + exit 2.
    There is no shell/exec/run/cmd/--command flag anywhere.

Subcommands:
  sync-docker-cidrs   collect Docker networks, write generated CIDR artifact
  status              filtered compose status for the fixed project
  logs <service>      filtered logs for one of the two fixed services
  deploy / redeploy   docker compose up -d [--force-recreate] on the fixed path
  run-acceptance      invoke sibling egress-host-test, pass through its report
  install-client <t>  copy a pre-built client bundle to a fixed target
  copy-personal-source copy a normalized personal snapshot to a test container client
"""

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener

# The installer records the dedicated service UID and non-default paths here.
# These are non-secret Compose substitutions, never executable shell input.
try:
    with open("/etc/egress/compose.env", encoding="utf-8") as _env_file:
        for _line in _env_file:
            _key, _sep, _value = _line.strip().partition("=")
            if _sep and _key in {"EGRESSD_UID", "EGRESSD_GID", "EGRESS_ROOT",
                                "EGRESS_SECRETS", "DOCKER_GATEWAY"}:
                os.environ.setdefault(_key, _value)
except OSError:
    pass

PROJ = "egress"
SERVICES = ("egress-mihomo", "egressd")
DEFAULT_ROOT = "/var/lib/egress"
DEFAULT_REPO = "/srv/workspace/egress"
HOST_INSTALL_DIR = "/etc/egress"
DEFAULT_CLIENT_BUNDLE_DIR = "/var/lib/egress/client-bundle"
# Docker >= 28 removed .Subnet/.Gateway from the `network ls` template context
# (a network may carry multiple IPAM configs, so they are no longer flattened).
# We therefore list name/id/driver via `ls` and read the IPAM config per network
# via `network inspect` (stable across all Docker versions).
DOCKER_LS_FORMAT = "{{.Name}}\t{{.ID}}\t{{.Driver}}"
DOCKER_INSPECT_IPAM_FORMAT = "{{range .IPAM.Config}}{{.Subnet}}\t{{.Gateway}}\n{{end}}"
REDACT = [
    re.compile(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]{4,}"),
    re.compile(r"(?i)\b(secret|token|api_?key|password|passwd|auth)\b(\s*[:=]\s*)(\"[^\"]*\"|'[^']*'|\S+)"),
]


def root_dir():
    return os.environ.get("EGRESS_ROOT", DEFAULT_ROOT)


def repo_dir():
    return os.environ.get("EGRESS_REPO", DEFAULT_REPO)


def client_bundle_dir():
    return os.environ.get("EGRESS_CLIENT_BUNDLE_DIR", DEFAULT_CLIENT_BUNDLE_DIR)


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def err(msg, code=1):
    sys.stderr.write("egress-hostctl: %s\n" % msg)
    sys.exit(code)


def sha8(data):
    return hashlib.sha256(data if isinstance(data, bytes) else data.encode()).hexdigest()[:8]


def run_fixed(argv, timeout=180):
    """Run a fixed, hardcoded argv list. No shell, no user-controlled argv."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", "command not found: %s" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "timeout: %s" % argv[0]


def redact(line):
    for rx in REDACT:
        line = rx.sub(lambda m: m.group(0).split(" ", 1)[0] + "=[REDACTED]"
                      if " " in m.group(0) else "[REDACTED]", line)
    return line


def compose_path(args):
    if getattr(args, "compose", None):
        c = os.path.realpath(args.compose)
    else:
        c = os.path.realpath(os.path.join(repo_dir(), "compose.yaml"))
    root = os.path.realpath(repo_dir())
    if not (c == root or c.startswith(root + os.sep)):
        err("compose path outside allowed repo root %s (path traversal rejected)" % root, 2)
    if not os.path.isfile(c):
        err("compose file not found: %s" % c, 2)
    return c


# --------------------------------------------------------------------------
# sync-docker-cidrs
# --------------------------------------------------------------------------

def collect_networks(args):
    if getattr(args, "offline", None):
        nets = []
        with open(args.offline, "r", encoding="utf-8") as f:
            for ln, raw in enumerate(f, 1):
                raw = raw.rstrip("\n")
                if not raw.strip() or raw.lstrip().startswith("#"):
                    continue
                parts = raw.split("\t")
                if len(parts) != 5:
                    err("offline fixture line %d: expected 5 tab-separated fields" % ln, 2)
                name, nid, driver, subnet, gateway = parts
                nets.append({"name": name, "id": nid, "driver": driver,
                             "subnet": subnet, "gateway": gateway})
        return nets, "offline:%s" % os.path.realpath(args.offline)
    dc = getattr(args, "docker_cmd", None) or "docker"
    rc, out, e = run_fixed([dc, "network", "ls", "--format", DOCKER_LS_FORMAT])
    if rc != 0:
        err("docker network ls failed (rc=%d): %s" % (rc, e.strip()[:200]))
    nets = []
    for raw in out.splitlines():
        raw = raw.rstrip()
        if not raw:
            continue
        parts = raw.split("\t")
        if len(parts) < 3:
            continue
        name, nid, driver = parts[0], parts[1], parts[2]
        # Subnet/gateway come from `network inspect` (Docker >= 28 dropped them
        # from the `ls` template context). A network can carry several IPAM
        # configs; we take the first one (the primary subnet).
        subnet, gateway = "", ""
        rc2, out2, e2 = run_fixed(
            [dc, "network", "inspect", "--format", DOCKER_INSPECT_IPAM_FORMAT, name])
        if rc2 == 0:
            for line in out2.splitlines():
                line = line.rstrip()
                if not line:
                    continue
                ipam = line.split("\t")
                subnet = ipam[0] if len(ipam) > 0 else ""
                gateway = ipam[1] if len(ipam) > 1 else ""
                break
        nets.append({"name": name, "id": nid, "driver": driver,
                     "subnet": subnet, "gateway": gateway})
    return nets, "docker:%s" % dc


def yaml_scalar(v):
    if v is None or v == "":
        return "''"
    s = str(v)
    if any(ch in s for ch in ":#{}[]&*!|>'\"%@`") or s != s.strip() or s == "":
        return "'" + s.replace("'", "''") + "'"
    return s


def emit_cidrs(nets, source, ts):
    lines = [
        "# generated by egress-hostctl sync-docker-cidrs -- do not edit",
        "generated_at: %s" % ts,
        "source: %s" % source,
        "network_count: %d" % len(nets),
        "networks:",
    ]
    for n in nets:
        lines.append("- name: %s" % yaml_scalar(n["name"]))
        lines.append("  id: %s" % yaml_scalar(n["id"]))
        lines.append("  driver: %s" % yaml_scalar(n["driver"]))
        lines.append("  subnet: %s" % yaml_scalar(n["subnet"]))
        lines.append("  gateway: %s" % yaml_scalar(n["gateway"]))
    return "\n".join(lines) + "\n"


def cmd_sync(args):
    nets, source = collect_networks(args)
    ts = now_iso()
    out = args.out or os.path.join(root_dir(), "generated", "docker-cidrs.yaml")
    out = os.path.realpath(out)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write(emit_cidrs(nets, source, ts))
    os.chmod(out, 0o600)
    print(json.dumps({"ok": True, "artifact": out, "network_count": len(nets),
                      "source": source, "generated_at": ts}))
    return 0


# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------

def parse_compose_ps(out):
    out = out.strip()
    if not out:
        return []
    try:
        data = json.loads(out)
    except ValueError:
        return []
    if isinstance(data, dict):
        data = data.get("services") or data.get("containers") or []
    svcs = []
    for c in data:
        if not isinstance(c, dict):
            continue
        name = c.get("name") or c.get("service") or c.get("Name") or ""
        state = c.get("state") or c.get("Status") or c.get("status") or "unknown"
        health = c.get("health") or c.get("Health") or ""
        if isinstance(health, dict):
            health = health.get("Status") or health.get("status") or ""
        svcs.append({"service": name, "state": str(state), "health": str(health)})
    return svcs


def cmd_status(args):
    if getattr(args, "offline", None):
        with open(args.offline, "r", encoding="utf-8") as f:
            raw = f.read()
        try:
            data = json.loads(raw)
        except ValueError:
            data = parse_compose_ps(raw)
        if isinstance(data, dict):
            data = data.get("services", data)
        print(json.dumps({"project": PROJ, "source": "offline:%s" % args.offline,
                          "services": data}, indent=2))
        return 0
    c = compose_path(args)
    rc, out, e = run_fixed(["docker", "compose", "-f", c, "ps", "--format", "json"])
    if rc != 0:
        print(json.dumps({"ok": False, "error": e.strip()[:300] or ("rc=%d" % rc)}))
        return rc
    print(json.dumps({"project": PROJ, "services": parse_compose_ps(out)}, indent=2))
    return 0


# --------------------------------------------------------------------------
# logs
# --------------------------------------------------------------------------

def cmd_logs(args):
    svc = args.service
    if svc not in SERVICES:
        err("service must be one of %s (got %r)" % (list(SERVICES), svc), 2)
    if args.offline:
        with open(args.offline, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
        if args.tail is not None:
            lines = lines[-args.tail:]
        for ln in lines:
            print(redact(ln))
        return 0
    c = compose_path(args)
    argv = ["docker", "compose", "-f", c, "logs", "--no-color", svc]
    if args.tail is not None:
        argv += ["--tail", str(args.tail)]
    rc, out, e = run_fixed(argv)
    if rc != 0:
        err("docker compose logs failed (rc=%d): %s" % (rc, e.strip()[:200]))
    for ln in out.splitlines():
        print(redact(ln))
    return 0


# --------------------------------------------------------------------------
# deploy / redeploy
# --------------------------------------------------------------------------

def cmd_deploy(args, force):
    c = compose_path(args)
    argv = ["docker", "compose", "-f", c, "up", "-d"]
    if force:
        argv.append("--force-recreate")
    rc, out, e = run_fixed(argv, timeout=600)
    if rc != 0:
        err("deploy failed (rc=%d): %s" % (rc, (e or out).strip()[:300]))
    print(json.dumps({"ok": True, "operation": "redeploy" if force else "deploy",
                      "compose": c}))
    return 0


# --------------------------------------------------------------------------
# run-acceptance
# --------------------------------------------------------------------------

def cmd_run_acceptance(args):
    here = os.path.dirname(os.path.realpath(__file__))
    test = os.path.join(here, "egress-host-test")
    if not os.path.isfile(test):
        err("sibling egress-host-test not found at %s" % test, 2)
    rc, out, e = run_fixed([sys.executable, test], timeout=900)
    if out:
        sys.stdout.write(out if out.endswith("\n") else out + "\n")
    if e:
        sys.stderr.write(e)
    return rc


# --------------------------------------------------------------------------
# install-client
# --------------------------------------------------------------------------

def _copy_fixed(src, dst):
    shutil.copy2(src, dst)
    os.chmod(dst, 0o600)


def cmd_install_client(args):
    target = args.target
    if target == "host":
        dest = HOST_INSTALL_DIR
    elif target == "container":
        dest = client_bundle_dir()
    else:
        err("target must be 'host' or 'container' (got %r)" % target, 2)
    bundle = os.path.realpath(args.bundle)
    if not os.path.isdir(bundle):
        err("bundle directory not found: %s" % args.bundle, 2)
    os.makedirs(dest, exist_ok=True)
    os.chmod(dest, 0o700)
    shutil.copytree(bundle, dest, dirs_exist_ok=True, copy_function=_copy_fixed)
    nfiles = sum(len(fs) for _, _, fs in os.walk(dest))
    print(json.dumps({"ok": True, "target": target, "dest": dest,
                      "files": nfiles, "perms": "dir=0700,file=0600"}))
    return 0


# --------------------------------------------------------------------------
# copy a private provider snapshot to a container test profile
# --------------------------------------------------------------------------

_PERSONAL_PROVIDER_RE = re.compile(r"^p-([A-Za-z0-9._-]{1,64})-([A-Za-z0-9._-]{1,32})$")
_CLIENT_ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
_ROUTE_ID_RE = re.compile(r"^([A-Za-z0-9._-]+):([A-Za-z0-9._-]+)$")


class _RejectRedirects(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


_PERSONAL_API_OPENER = build_opener(ProxyHandler({}), _RejectRedirects())


def _read_secret(path):
    try:
        if path.is_symlink() or not path.is_file():
            err("required client credential is missing or unsafe", 3)
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        err("cannot read required client credential", 3)
    if not value:
        err("required client credential is empty", 3)
    return value


def _personal_api(method, path, token, payload=None):
    body = None if payload is None else json.dumps(payload).encode("utf-8")
    request = Request(
        "http://127.0.0.1:9091" + path,
        data=body,
        method=method,
        headers={"Authorization": "Bearer " + token,
                 "Content-Type": "application/json"},
    )
    try:
        with _PERSONAL_API_OPENER.open(request, timeout=15) as response:
            raw = response.read(65536)
    except HTTPError as exc:
        err("personal snapshot API returned HTTP %d" % exc.code, 3)
    except (URLError, OSError, TimeoutError):
        err("personal snapshot API is unavailable on 127.0.0.1:9091", 3)
    try:
        result = json.loads(raw.decode("utf-8"))
    except (UnicodeError, ValueError):
        err("personal snapshot API returned invalid JSON", 3)
    if not isinstance(result, dict):
        err("personal snapshot API returned an invalid response", 3)
    return result


def cmd_copy_personal_source(args):
    if os.geteuid() != 0:
        err("copy-personal-source must run as root", 3)
    if not _CLIENT_ID_RE.fullmatch(args.target_client):
        err("invalid target client ID", 2)
    source_client = getattr(args, "source_client", None)
    source_route = args.source_route
    alias_match = re.fullmatch(r"@([A-Za-z0-9][A-Za-z0-9._-]{0,31}):([A-Za-z0-9._-]+)", source_route)
    if source_route.startswith("@") and not alias_match:
        err("source route shorthand must look like @alias:node", 2)
    if alias_match:
        if not source_client:
            err("--source-client is required for a personal route alias", 2)
        personal_dir = Path(root_dir()).resolve() / "egressd" / "personal"
        matches = []
        for meta_path in personal_dir.glob("p-*.json"):
            try:
                candidate = json.loads(meta_path.read_text(encoding="utf-8"))
            except (OSError, ValueError, UnicodeError):
                continue
            if candidate.get("client_id") == source_client and candidate.get("alias") == alias_match.group(1):
                matches.append(meta_path.stem)
        if len(matches) != 1:
            err("personal route alias is unknown or ambiguous for source client", 2)
        source_route = matches[0] + ":" + alias_match.group(2)
    route = _ROUTE_ID_RE.fullmatch(source_route)
    if not route:
        err("source route must be a personal route ID or @alias:node", 2)
    source_provider, node = route.groups()
    if not _PERSONAL_PROVIDER_RE.fullmatch(source_provider):
        err("source route is not a personal provider route", 2)

    root = Path(root_dir()).resolve()
    secrets = Path(os.environ.get("EGRESS_SECRETS",
                                  "/etc/egress/secrets")).resolve()
    if source_client:
        if not _CLIENT_ID_RE.fullmatch(source_client):
            err("invalid source client ID", 2)
        source_profile_path = secrets / "clients" / (source_client + ".profile.json")
        try:
            source_profile = json.loads(source_profile_path.read_text(encoding="utf-8"))
        except (OSError, ValueError, UnicodeError):
            err("source client profile is missing or invalid", 3)
        if source_profile.get("client_id") != source_client or source_profile.get("environment") != "host":
            err("source client profile must belong to a host environment", 2)
    providers_dir = (root / "providers").resolve()
    personal_dir = (root / "egressd" / "personal").resolve()
    source_yaml = providers_dir / (source_provider + ".yaml")
    source_meta = personal_dir / (source_provider + ".json")
    target_profile = secrets / "clients" / (args.target_client + ".profile.json")
    target_token_path = secrets / "clients" / (args.target_client + ".token")

    if source_yaml.is_symlink() or source_meta.is_symlink() or target_profile.is_symlink():
        err("personal provider or target profile path is unsafe", 3)
    try:
        meta = json.loads(source_meta.read_text(encoding="utf-8"))
        source = source_yaml.read_bytes()
    except (OSError, ValueError, UnicodeError):
        err("personal provider snapshot or metadata is missing", 3)
    if meta.get("provider_id") != source_provider or \
       not _CLIENT_ID_RE.fullmatch(str(meta.get("client_id", ""))) or \
       not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,31}", str(meta.get("alias", ""))):
        err("personal provider metadata is invalid", 3)
    if source_client and meta.get("client_id") != source_client:
        err("source provider does not belong to --source-client", 2)
    if len(source) > 4 * 1024 * 1024:
        err("personal provider snapshot exceeds the supported size", 3)
    current_provider = "p-%s-%s" % (meta["client_id"], meta["alias"])
    if source_provider != current_provider:
        err("personal provider ID does not match its metadata", 3)
    try:
        profile = json.loads(target_profile.read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeError):
        err("target client profile is missing or invalid", 3)
    if profile.get("client_id") != args.target_client or \
       profile.get("environment") != "container":
        err("target profile must be the requested container client", 3)

    source_alias = meta["alias"]
    suffix = hashlib.sha256(source_provider.encode("ascii")).hexdigest()[:8]
    target_alias = "test-%s-%s" % (source_alias[:18], suffix)
    target_alias = target_alias[:32]
    target_provider = "p-%s-%s" % (args.target_client, target_alias)
    target_meta_path = personal_dir / (target_provider + ".json")
    target_yaml_path = providers_dir / (target_provider + ".yaml")
    if target_yaml_path.is_symlink():
        err("target test snapshot path is unsafe", 3)
    if target_yaml_path.exists() and not target_meta_path.exists():
        err("target test snapshot ID conflicts with an existing provider", 3)
    if target_meta_path.exists():
        if target_meta_path.is_symlink():
            err("target test snapshot metadata path is unsafe", 3)
        try:
            old_target = json.loads(target_meta_path.read_text(encoding="utf-8"))
        except (OSError, ValueError, UnicodeError):
            err("target test snapshot metadata is invalid", 3)
        if old_target.get("client_id") != args.target_client or \
           old_target.get("kind") != "snapshot":
            err("generated test alias collides with a non-test personal source", 3)

    source_token_path = secrets / "clients" / (meta["client_id"] + ".token")
    source_token = _read_secret(source_token_path)
    target_token = _read_secret(target_token_path)
    source_route_quoted = quote(source_route, safe="")
    # Confirm that the source profile can see this exact route before copying
    # any provider data to the explicitly selected test client.
    _personal_api("GET", "/v1/routes/" + source_route_quoted, source_token)

    try:
        yaml_text = source.decode("utf-8")
    except UnicodeError:
        err("personal provider snapshot is not UTF-8", 3)
    body = _personal_api(
        "PUT", "/v1/personal/providers/%s/snapshot" % quote(target_alias, safe=""),
        target_token, {"yaml": yaml_text},
    )
    if body.get("provider_id") != target_provider:
        err("personal snapshot API returned an unexpected provider ID", 3)
    copied_route = target_provider + ":" + node
    _personal_api("GET", "/v1/routes/" + quote(copied_route, safe=""), target_token)
    print(json.dumps({
        "ok": True,
        "source_provider": source_provider,
        "target_provider": body.get("provider_id", target_provider),
        "target_route": copied_route,
        "node_count": body.get("node_count"),
    }, sort_keys=True))
    return 0


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(prog="egress-hostctl", add_help=True,
                                description="narrow host control CLI (fixed operations only)")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("sync-docker-cidrs", help="write generated Docker CIDR artifact")
    s.add_argument("--out")
    s.add_argument("--docker-cmd", default="docker")
    s.add_argument("--offline")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("status", help="filtered compose status")
    s.add_argument("--compose")
    s.add_argument("--offline")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("logs", help="filtered logs for one fixed service")
    s.add_argument("service")
    s.add_argument("--tail", type=int, default=None)
    s.add_argument("--compose")
    s.add_argument("--offline")
    s.set_defaults(fn=cmd_logs)

    s = sub.add_parser("deploy", help="docker compose up -d (fixed compose path)")
    s.add_argument("--compose")
    s.set_defaults(fn=lambda a: cmd_deploy(a, False))

    s = sub.add_parser("redeploy", help="docker compose up -d --force-recreate")
    s.add_argument("--compose")
    s.set_defaults(fn=lambda a: cmd_deploy(a, True))

    s = sub.add_parser("run-acceptance", help="run sibling egress-host-test")
    s.set_defaults(fn=cmd_run_acceptance)

    s = sub.add_parser("install-client", help="install pre-built client bundle to fixed target")
    s.add_argument("target", choices=["host", "container"])
    s.add_argument("--bundle", required=True)
    s.set_defaults(fn=cmd_install_client)

    s = sub.add_parser("copy-personal-source",
                       help="copy a normalized personal provider snapshot to a container client")
    s.add_argument("--source-route", required=True)
    s.add_argument("--source-client")
    s.add_argument("--target-client", required=True)
    s.set_defaults(fn=cmd_copy_personal_source)

    return p


def main(argv=None):
    p = build_parser()
    a = p.parse_args(argv)
    if not getattr(a, "fn", None):
        p.print_usage(sys.stderr)
        err("missing or unknown subcommand (allowed: sync-docker-cidrs, status, logs, "
            "deploy, redeploy, run-acceptance, install-client, copy-personal-source)", 2)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
