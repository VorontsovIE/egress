def check_no_public_binds():
    comp, path = load_compose()
    if comp is None:
        add("no_public_binds", "skipped", "compose.yaml not found", path)
        return
    services = comp.get("services", {}) or {}
    bad = []
    checked = 0
    for name, svc in services.items():
        if not isinstance(svc, dict):
            continue
        for entry in (svc.get("ports") or []):
            checked += 1
            host_ip, _, _ = parse_ports_entry(entry)
            if host_ip is None:
                bad.append(f"{name}:{entry} (no host bind -> 0.0.0.0)")
            elif not is_local_bind(host_ip):
                bad.append(f"{name}:{entry} (public bind {host_ip})")
    if bad:
        add("no_public_binds", "fail", f"{len(bad)} public bind(s)",
            "; ".join(bad[:5]))
    else:
        add("no_public_binds", "pass",
            f"all {checked} published port(s) bound to local addresses")


def check_docker_socket_not_mounted():
    comp, path = load_compose()
    if comp is None:
        add("docker_socket_not_mounted", "skipped", "compose.yaml not found", path)
        return
    services = comp.get("services", {}) or {}
    bad = []
    for name, svc in services.items():
        if not isinstance(svc, dict):
            continue
        for v in (svc.get("volumes") or []):
            if "docker.sock" in str(v):
                bad.append(f"{name}:{v}")
    if bad:
        add("docker_socket_not_mounted", "fail", "docker socket mounted",
            "; ".join(bad))
    else:
        add("docker_socket_not_mounted", "pass",
            "no service mounts /var/run/docker.sock")


def check_mihomo_admin_api_private():
    comp, path = load_compose()
    if comp is None:
        add("mihomo_admin_api_private", "skipped", "compose.yaml not found", path)
        return
    services = comp.get("services", {}) or {}
    bad = []
    for name, svc in services.items():
        if not isinstance(svc, dict):
