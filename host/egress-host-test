    if image == MIHOMO_IMAGE_PIN:
        add("image_versions", "pass", f"mihomo pinned to {image}")
    else:
        add("image_versions", "fail",
            f"mihomo image {image!r} != pinned {MIHOMO_IMAGE_PIN!r}")


def check_client_tokens_distinct():
    clients_dir = os.path.join(SECRETS, "clients")
    if not os.path.isdir(clients_dir):
        add("client_tokens_distinct", "skipped",
            f"no client secrets dir at {clients_dir}")
        return
    tokens = {}
    for fn in sorted(os.listdir(clients_dir)):
        if fn.endswith(".token"):
            data = read_file(os.path.join(clients_dir, fn))
            if data is not None:
                tokens[fn] = sha8(data.strip())
    if len(tokens) < 2:
        add("client_tokens_distinct", "skipped",
            f"only {len(tokens)} client token(s) present")
        return
    hashes = list(tokens.values())
    if len(set(hashes)) == len(hashes):
        add("client_tokens_distinct", "pass",
            f"{len(tokens)} client tokens are pairwise distinct",
            "; ".join(f"{k}={v}" for k, v in tokens.items()))
    else:
        dup = sorted({k for k, v in tokens.items() if hashes.count(v) > 1})
        add("client_tokens_distinct", "fail",
            f"duplicate token value(s) among {dup}")


def check_no_backend_secrets_in_client_bundles():
    # collect secret values to scan for (never printed)
    needles = []
    mihomo_secret = os.path.join(SECRETS, "mihomo_api_secret")
    ms = read_file(mihomo_secret)
    if ms and ms.strip():
        needles.append(("mihomo_api_secret", ms.strip()))
    prov_dir = os.path.join(SECRETS, "providers")
    if os.path.isdir(prov_dir):
        for fn in sorted(os.listdir(prov_dir)):
            p = os.path.join(prov_dir, fn)
            if os.path.isfile(p):
                data = read_file(p)
                if data and len(data.strip()) >= 8:
                    needles.append((f"providers/{fn}", data.strip()))
    if not needles:
        add("no_backend_secrets_in_client_bundles", "skipped",
            "no backend secrets to scan against")
        return
    # client dirs to scan
    client_dirs = []
    bundle_root = os.path.join(ROOT, "client-bundles")
    if os.path.isdir(bundle_root):
        client_dirs.append(bundle_root)
    if os.path.isdir(HOST_CLIENT_DIR):
        client_dirs.append(HOST_CLIENT_DIR)
    if not client_dirs:
        add("no_backend_secrets_in_client_bundles", "skipped",
            "no client bundle/install dirs found")
        return
    leaks = []
    for cdir in client_dirs:
        for root, dirs, files in os.walk(cdir):
            # The backend secrets dir is where backend secrets BELONG; it is
            # not a client artifact. Prune it so the check only scans client
            # bundle/install content (on the host, SECRETS lives under
            # /etc/vibelab-egress/secrets, inside HOST_CLIENT_DIR).
            dirs[:] = [d for d in dirs
                       if os.path.realpath(os.path.join(root, d))
                       != os.path.realpath(SECRETS)]
            for f in files:
                fp = os.path.join(root, f)
                try:
                    with open(fp, "rb") as fh:
                        content = fh.read()
                except OSError:
                    continue
                for label, needle in needles:
                    if needle.encode() in content:
                        leaks.append(f"{fp} contains {label}")
    if leaks:
        add("no_backend_secrets_in_client_bundles", "fail",
            f"{len(leaks)} leak(s)", "; ".join(leaks[:5]))
    else:
        add("no_backend_secrets_in_client_bundles", "pass",
            f"no backend secrets found in {len(client_dirs)} client dir(s)")


def check_no_arbitrary_host_command():
    here = os.path.dirname(os.path.realpath(__file__))
    hostctl = os.path.join(here, "egress-hostctl")
    if not os.path.isfile(hostctl):
        add("no_arbitrary_host_command", "skipped", "egress-hostctl not found")
        return
    problems = []
    # 1. a free-form subcommand must be rejected with exit 2
    try:
        p = subprocess.run([sys.executable, hostctl, "rm-rf", "/"],
                           capture_output=True, text=True, timeout=30)
        if p.returncode != 2:
            problems.append(f"bogus subcommand exit={p.returncode} (expected 2)")
    except Exception as e:
        problems.append(f"could not run egress-hostctl: {e}")
    # 2. source must not use shell=True / os.system / eval / exec.
    #    AST-based: only real calls count (docstrings/comments mentioning
    #    the patterns are not a problem).
    src = read_file(hostctl) or ""
    try:
        tree = ast.parse(src)
    except SyntaxError as e:
        problems.append(f"source does not parse: {e}")
        tree = None
    if tree is not None:
        for node in ast.walk(tree):
            if not isinstance(node, ast.Call):
                continue
            f = node.func
            if isinstance(f, ast.Name) and f.id in ("eval", "exec"):
                problems.append(f"source contains {f.id}( call")
            if (isinstance(f, ast.Attribute) and f.attr == "system"
                    and isinstance(f.value, ast.Name) and f.value.id == "os"):
                problems.append("source contains os.system( call")
            if (isinstance(f, ast.Attribute)
                    and f.attr in ("run", "Popen", "call", "check_output",
                                   "check_call")):
                for kw in node.keywords:
                    if (kw.arg == "shell" and isinstance(kw.value, ast.Constant)
                            and kw.value.value is True):
                        problems.append("subprocess call with shell=True")
    if problems:
        add("no_arbitrary_host_command", "fail", "; ".join(problems))
    else:
        add("no_arbitrary_host_command", "pass",
            "free-form subcommand rejected (exit 2); no shell=True/os.system/eval/exec")


def check_client_install_survives_recreate():
    # the client install/bundle root must be a persistent path, not a
    # container writable layer / tmpfs
    bundle_root = os.path.join(ROOT, "client-bundles")
    persistent_prefixes = (ROOT, "/etc", "/home", "/var/lib")
    candidates = [bundle_root, HOST_CLIENT_DIR]
    ok = []
    for c in candidates:
        if os.path.isdir(c):
            if any(c == p or c.startswith(p + os.sep) for p in persistent_prefixes):
                ok.append(c)
            else:
                add("client_install_survives_recreate", "fail",
                    f"client dir {c} is not under a persistent prefix")
                return
    if ok:
        add("client_install_survives_recreate", "pass",
            f"client install under persistent path(s): {', '.join(ok)}")
    else:
        add("client_install_survives_recreate", "skipped",
            "no client install dir present to check")


def check_docker_cidr_artifact_fresh():
    artifact = os.path.join(ROOT, "generated", "docker-cidrs.yaml")
    if not os.path.isfile(artifact):
        add("docker_cidr_artifact_fresh", "fail", f"artifact missing: {artifact}")
        return
    text = read_file(artifact) or ""
    m = re.search(r"^generated_at:\s*(\S+)", text, re.MULTILINE)
    if not m:
        add("docker_cidr_artifact_fresh", "fail", "no generated_at field")
        return
    try:
        ts = datetime.strptime(m.group(1).replace("Z", "+0000"),
                                "%Y-%m-%dT%H:%M:%S%z")
    except ValueError:
        add("docker_cidr_artifact_fresh", "fail",
            f"unparseable generated_at {m.group(1)!r}")
        return
    age_h = (datetime.now(timezone.utc) - ts).total_seconds() / 3600.0
    if age_h <= 24:
        add("docker_cidr_artifact_fresh", "pass",
            f"artifact age {age_h:.1f}h (<= 24h)", f"generated_at={m.group(1)}")
    else:
        add("docker_cidr_artifact_fresh", "fail",
            f"artifact age {age_h:.1f}h (> 24h)", f"generated_at={m.group(1)}")


def check_persistent_dirs_permissions():
    if not os.path.isdir(ROOT):
        add("persistent_dirs_permissions", "skipped", f"persistent root absent: {ROOT}")
        return
    bad = []
    checked = 0
    # egressd runs as uid 1000 (non-root) and must write its state/metrics/geo
    # store there, so it is intentionally 0755 (owner uid 1000); everything
    # else under the persistent root must stay 0700 (root-only).
    expected = {"egressd": "0o755"}
    for entry in sorted(os.listdir(ROOT)):
        p = os.path.join(ROOT, entry)
        if os.path.isdir(p):
            checked += 1
            mode = oct(os.stat(p).st_mode & 0o777)
            if mode != expected.get(entry, "0o700"):
                bad.append(f"{entry}={mode}")
    if bad:
        add("persistent_dirs_permissions", "fail",
            f"{len(bad)} dir(s) not 0700", "; ".join(bad[:5]))
    else:
        add("persistent_dirs_permissions", "pass",
            f"{checked} persistent dir(s) are 0700")


def check_host_client_config_token_permissions():
    if not os.path.isdir(HOST_CLIENT_DIR):
        add("host_client_config_token_permissions", "skipped",
            f"host client dir absent: {HOST_CLIENT_DIR}")
        return
    bad = []
    for fn in ("client.yaml", "client.token", "default-proxy.auth"):
        p = os.path.join(HOST_CLIENT_DIR, fn)
        if not os.path.isfile(p):
            bad.append(f"{fn} missing")
            continue
        mode = oct(os.stat(p).st_mode & 0o777)
        expected = "0o644" if fn == "client.yaml" else "0o600"
        if mode != expected:
            bad.append(f"{fn}={mode} (expected {expected})")
    if bad:
        add("host_client_config_token_permissions", "fail", "; ".join(bad))
    else:
        add("host_client_config_token_permissions", "pass",
            "host client.yaml/token/auth present with correct perms")


def check_compose_health(live):
    if not live:
        add("compose_health", "skipped", "no docker daemon (static mode)")
        return
    comp, path = load_compose()
    if comp is None:
        add("compose_health", "skipped", "compose.yaml not found")
        return
    try:
        p = subprocess.run(
            ["docker", "compose", "-f", os.path.join(REPO, "compose.yaml"), "ps", "--format", "json"],
            capture_output=True, text=True, timeout=60)
        if p.returncode != 0:
            add("compose_health", "fail", f"compose ps failed: {p.stderr.strip()[:200]}")
            return
        add("compose_health", "pass", "compose ps succeeded (live)")
    except Exception as e:
        add("compose_health", "fail", f"could not query compose: {e}")


def check_restart_recreate(live):
