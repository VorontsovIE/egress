def check_host_whoami_identity(live):
    if not live:
        add("host_whoami_identity", "skipped", "no live backend (static mode)")
        return
    try:
        # NOTE: --json is a global flag and must precede the subcommand.
        p = subprocess.run(["egressctl", "--json", "whoami"],
                           capture_output=True, text=True, timeout=30)
        if p.returncode != 0:
            add("host_whoami_identity", "fail",
                f"egressctl whoami rc={p.returncode}: {p.stderr.strip()[:200]}")
            return
        data = json.loads(p.stdout)
        if data.get("client_id") == "host-main":
            add("host_whoami_identity", "pass", "host whoami = host-main")
        else:
            add("host_whoami_identity", "fail",
                f"host whoami = {data.get('client_id')!r} (expected host-main)")
    except Exception as e:
        add("host_whoami_identity", "fail", f"egressctl whoami failed: {e}")


def check_host_default_route_mode(live):
    if not live:
        add("host_default_route_mode", "skipped", "no live backend (static mode)")
        return
    try:
        # NOTE: --json is a global flag and must precede the subcommand.
        route = subprocess.run(["egressctl", "--json", "route", "current"],
                               capture_output=True, text=True, timeout=30)
        mode = subprocess.run(["egressctl", "--json", "mode", "current"],
                              capture_output=True, text=True, timeout=30)
        if route.returncode != 0 or mode.returncode != 0:
            add("host_default_route_mode", "fail",
                f"route rc={route.returncode} mode rc={mode.returncode}")
            return
        add("host_default_route_mode", "pass",
            f"route={json.loads(route.stdout).get('route')} "
            f"mode={json.loads(mode.stdout).get('mode')}")
    except Exception as e:
        add("host_default_route_mode", "fail", f"could not read host default: {e}")


