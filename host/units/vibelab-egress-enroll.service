[Unit]
Description=vibelab-egress local host profile enrollment
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=vibelab-egressd
Group=vibelab-egressd
RuntimeDirectory=vibelab-egress-enroll
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/libexec/vibelab-egress/egress-enroll
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/vibelab-egress/secrets/clients /run/vibelab-egress-enroll
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
