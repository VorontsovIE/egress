# Host-native strict/TUN helper. This unit is optional and installed only by
# scripts/install-tun-host.sh. The command workload inherits the host mount
# namespace, so filesystem sandboxing on this service is intentionally absent.
[Unit]
Description=vibelab-egress host-native strict/TUN helper
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=vibelab-egress-tun
EnvironmentFile=-/etc/vibelab-egress/tun-host.env
ExecStart=/usr/bin/python3 /usr/local/libexec/vibelab-egress/egress-tun-helper.py --socket /run/vibelab-egress/tun-helper.sock --allowed-upstreams 127.0.0.1:1081
Restart=on-failure
RestartSec=3
RuntimeDirectory=vibelab-egress
RuntimeDirectoryMode=0755
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL CAP_SETPCAP
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL CAP_SETPCAP
NoNewPrivileges=true
PrivateNetwork=false
PrivateTmp=false
ProtectHome=false
ProtectSystem=false
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
