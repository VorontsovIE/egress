[Unit]
Description=egress local host profile enrollment
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=egressd
Group=egressd
RuntimeDirectory=egress-enroll
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/libexec/egress/egress-enroll
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/egress/secrets/clients /run/egress-enroll
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
